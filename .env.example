# Copy to .env (for scripts/) and .dev.vars (for the Workers service).
# Both are gitignored. Never commit real values.

# ── ElevenLabs ────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Voice ID of the professional voice clone, shared by all four agents.
# Populated after the clone is created (phase 3).
ELEVENLABS_VOICE_ID=

# HMAC secret for verifying post-call webhooks. Shown once when you register
# the webhook in the ElevenLabs dashboard.
ELEVENLABS_WEBHOOK_SECRET=

# ── Tool webhook auth ─────────────────────────────────────────────────────
# Shared secret the agents send as X-Agent-Secret on every tool call.
# Generate with: openssl rand -hex 32
AGENT_TOOL_SECRET=

# ── Access gate ───────────────────────────────────────────────────────────
# Passcode for the friend / virtual-me paths. Compared server-side only;
# this value must never appear in an agent prompt or knowledge base file.
ACCESS_PASSCODE=

# ── Screening bar ─────────────────────────────────────────────────────────
# Used to evaluate inbound opportunities. Never sent to the LLM as text —
# only the resulting verdict is.
SCREEN_COMP_FLOOR=
SCREEN_WORK_MODE=            # remote | hybrid | onsite | any
SCREEN_WORK_MODE_STRICT=false # true = mismatch is a hard no; false = preference only
SCREEN_LOCATIONS=            # comma-separated, e.g. "New York,Remote US"
SCREEN_STAGES=               # comma-separated, e.g. "seed,series-a,series-b"
SCREEN_ROLES_YES=            # comma-separated role keywords that are a fit
SCREEN_ROLES_NO=             # comma-separated automatic passes
SCREEN_DISQUALIFIERS=        # comma-separated instant no, e.g. "unpaid,commission-only"

# ── Notifications ─────────────────────────────────────────────────────────
NOTIFY_CHANNEL=email         # email | slack | both
NOTIFY_EMAIL_TO=
RESEND_API_KEY=
SLACK_WEBHOOK_URL=

# ── Guardrails ────────────────────────────────────────────────────────────
MAX_PASSCODE_ATTEMPTS=5      # per caller number, per window
PASSCODE_WINDOW_SECONDS=3600
MAX_CALLS_PER_NUMBER_PER_DAY=10
